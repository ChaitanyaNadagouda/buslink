# Copy this file to infrastructure/.env and fill in real values.
# infrastructure/.env is gitignored and must never be committed.

# PostgreSQL
POSTGRES_DB=buslink
POSTGRES_USER=
POSTGRES_PASSWORD=

# pgAdmin
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# JWT signing secret (Spring Boot only, Compose doesn't use this).
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Razorpay (test mode) — Spring Boot only, Compose doesn't use this.
# Dashboard: https://dashboard.razorpay.com/ → Settings → API Keys / Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
